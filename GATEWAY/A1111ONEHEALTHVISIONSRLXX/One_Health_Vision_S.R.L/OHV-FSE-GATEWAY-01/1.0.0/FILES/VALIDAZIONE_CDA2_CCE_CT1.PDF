                  <family>Neri</family>
                </name>
              </assignedPerson>
            </assignedAuthor>
          </author>
          <entry>
            <observationMedia moodCode="EVN" classCode="OBS">
              <templateId root="2.16.840.1.113883.3.1937.777.63.10.866" />
