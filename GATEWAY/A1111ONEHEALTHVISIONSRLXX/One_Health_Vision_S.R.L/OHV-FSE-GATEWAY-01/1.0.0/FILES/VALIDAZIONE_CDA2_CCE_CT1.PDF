          <code code="8650-4" codeSystem="2.16.840.1.113883.6.1" codeSystemName="LOINC" displayName="Hospital discharge summary" />
          <title>Dimissione</title>
          <text>
            <paragraph>Paziente dimessa in buone condizioni generali. Terapia domiciliare prescritta. Follow-up ambulatoriale programmato.</paragraph>
          </text>
          <author typeCode="AUT" contextControlCode="OP">
            <time value="20250509100000+0100" />
